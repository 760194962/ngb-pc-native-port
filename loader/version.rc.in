// The version block shown in a program's Properties > Details (product, version, description). Filled in by
// CMakeLists.txt (ngb_version_info) for each program. Unsigned programs with an empty version block look more
// suspicious to antivirus heuristics; 1.1.11's launcher was a Defender machine-learning false positive.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @NGB_RC_TYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "akiraHayabusa"
            VALUE "FileDescription", "@NGB_RC_DESC@"
            VALUE "FileVersion", "@NGB_VERSION_STRING@"
            VALUE "InternalName", "@NGB_RC_INTERNAL@"
            VALUE "OriginalFilename", "@NGB_RC_FILE@"
            VALUE "ProductName", "Ninja Gaiden Black Hurricane PC Native Port"
            VALUE "ProductVersion", "@NGB_VERSION_STRING@"
            VALUE "Comments", "Fan-made native PC port; https://github.com/akirahayabusa/ngb-pc-native-port-release"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
